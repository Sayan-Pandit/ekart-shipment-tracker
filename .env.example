# Ekart Shipment Tracker Configuration

# Server Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=5050
POLL_INTERVAL_SECONDS=120
API_KEY=
CORS_ORIGINS=*
CSRF_TOKEN_TTL_SECONDS=1800

# Notification Channel 1: Email (SMTP)
NOTIFY_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=Ekart Tracker <your_email@gmail.com>
EMAIL_TO=recipient@example.com

# Notification Channel 2: Discord (Discord Bot & Webhook)
NOTIFY_WEBHOOK_ENABLED=true
DISCORD_BOT_ENABLED=true
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
DISCORD_PREFIX=!

# Optional Discord Webhook (fallback if bot is not active)
WEBHOOK_URL=https://discord.com/api/webhooks/...

# Database Settings
# Leave empty to use local SQLite (./data/tracker.db)
# Or set to PostgreSQL URL (e.g. from Render / Supabase / Neon) for permanent cloud storage:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Storage Directory (for SQLite)
STORAGE_DIR=./data

# Timezone (Default: Indian Standard Time UTC+05:30)
TZ=Asia/Kolkata
TIMEZONE=Asia/Kolkata
